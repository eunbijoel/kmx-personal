# Copy to backend/.env or export in the shell before uvicorn.

# Ollama (Workbench + /predict)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:12b

# Workbench rulebook content source:
#   field_dictionary = KMX control-plane vocabulary (default, not KSA-certified)
#   mock             = synthetic JSON fixture under data/agent_workbench/rulebooks/
KMX_RULEBOOK_SOURCE=field_dictionary

# Database
# DATABASE_URL=sqlite+aiosqlite:///./kmx_platform.db
